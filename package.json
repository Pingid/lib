{
  "name": "@pingid/lib",
  "version": "0.0.1",
  "description": "Set of personal libraries",
  "keywords": [
    "compose",
    "docker-compose",
    "proxy",
    "reverse-proxy",
    "fetch"
  ],
  "author": "pingid",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pingid/lib.git"
  },
  "bugs": {
    "url": "https://github.com/Pingid/lib/issues"
  },
  "homepage": "https://github.com/Pingid/lib#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@sinclair/typebox": "0.33.24",
    "@standard-schema/spec": "^1.1.0",
    "@redocly/openapi-core": "1.34.20",
